    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash-preload.js",
      "server.js",
      "warm-child.js",
      "world-run.js",
      "map-data.js",
