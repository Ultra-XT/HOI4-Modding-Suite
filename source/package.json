      "mod-version.js",
      "update-checker.js",
      "ai-vocab.js",
      "public/**/*",
      "data/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "texconv.exe",
        "to": "runtime-tools/texconv.exe"
      }
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "third-party/licenses",
        "to": "licenses",
        "filter": [
          "*.txt"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
